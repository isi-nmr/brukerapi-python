{
  "pv_version": [
    {
      "cmd": "#ACQ_sw_version[1:-1].replace('PV-','').replace('PV ','').strip()",
      "conditions": [],
      "comment": "spec 7.1/13: version gates compare on this parsed version, so an unlisted point release is not silently unsupported"
    },
    {
      "cmd": "''",
      "conditions": []
    }
  ],
  "numpy_dtype": [
    {
        "cmd": "np.dtype('int32').newbyteorder('<')",
        "conditions": [
          "#GO_raw_data_format=='GO_32BIT_SGN_INT'",
          "#BYTORDA=='little'"
        ]
    },
    {
        "cmd": "np.dtype('int16').newbyteorder('<')",
        "conditions": [
          "#GO_raw_data_format=='GO_16BIT_SGN_INT'",
          "#BYTORDA=='little'"
        ]
    },
    {
        "cmd": "np.dtype('float32').newbyteorder('<')",
        "conditions": [
          "#GO_raw_data_format=='GO_32BIT_FLOAT'",
          "#BYTORDA=='little'"
        ]
    },
    {
        "cmd": "np.dtype('int32').newbyteorder('>')",
        "conditions": [
          "#GO_raw_data_format=='GO_32BIT_SGN_INT'",
          "#BYTORDA=='big'"
        ]
    },
    {
        "cmd": "np.dtype('int16').newbyteorder('>')",
        "conditions": [
          "#GO_raw_data_format=='GO_16BIT_SGN_INT'",
          "#BYTORDA=='big'"
        ]
    },
    {
        "cmd": "np.dtype('float32').newbyteorder('>')",
        "conditions": [
          "#GO_raw_data_format=='GO_32BIT_FLOAT'",
          "#BYTORDA=='big'"
        ]
    },
    {
        "cmd": "np.dtype('i4').newbyteorder('<')",
        "conditions": [
          "#ACQ_word_size=='_32_BIT'",
          "#BYTORDA=='little'",
          "@pv_version.split('.')[0]=='360'"
        ]
    },
    {
        "cmd": "np.dtype('i4').newbyteorder('>')",
        "conditions": [
          "#ACQ_word_size=='_32_BIT'",
          "#BYTORDA=='big'",
          "@pv_version.split('.')[0]=='360'"
        ]
    },
    {
        "cmd": "np.dtype('i2').newbyteorder('<')",
        "conditions": [
          "#ACQ_word_size=='_16_BIT'",
          "#BYTORDA=='little'",
          "@pv_version.split('.')[0]=='360'"
        ]
    },
    {
        "cmd": "np.dtype('i2').newbyteorder('>')",
        "conditions": [
          "#ACQ_word_size=='_16_BIT'",
          "#BYTORDA=='big'",
          "@pv_version.split('.')[0]=='360'"
        ]
    }
  ],
  "channels": [
    {
      "cmd": "1",
      "conditions": [
        "#ACQ_dim_desc.__class__.__name__=='str'",
        "#ACQ_dim_desc=='Spectroscopic'"
      ]
    },
    {
      "cmd": "1",
      "conditions": [
        "#ACQ_dim_desc[0]=='Spectroscopic'"
      ]
    },
    {
      "cmd": "#PVM_EncNReceivers",
      "conditions": [
        "#ACQ_dim_desc[0]!='Spectroscopic'"
      ]
    }
  ],
  "block_size": [
    {
      "cmd": "int((np.ceil(#ACQ_size.tuple[0] * @channels * @numpy_dtype.itemsize / 1024.) * 1024. / @numpy_dtype.itemsize))",
      "conditions": [
        "#GO_block_size=='Standard_KBlock_Format'"
      ]
    },
    {
      "cmd": "int(#ACQ_size.tuple[0] * @channels)",
      "conditions": [
        "#GO_block_size!='Standard_KBlock_Format'"
      ]
    },
    {
      "cmd": "#ACQ_jobs[0][0]",
      "conditions": [
        "@pv_version.split('.')[0]=='360'"
      ]
    }
  ],
  "acq_length": [
    {
      "cmd": "#ACQ_size.tuple[0] * @channels",
      "conditions": [
        ["#PULPROG", ["<SPIRAL.ppg>","<DtiSpiral.ppg>"]],
        "@pv_version.split('.')[0]=='5'"
      ]
    },
    {
      "cmd": "#ACQ_size.tuple[0] * @channels",
      "conditions": [
        "#GO_block_size=='Standard_KBlock_Format'"
      ]
    },
    {
      "cmd": "int(2 * #PVM_DigNp * @channels)",
      "conditions": [
        "#GO_block_size!='Standard_KBlock_Format'"
      ],
      "comment": "spec 3.1: for GO_block_size=continuous the whole block is digitized data. Dividing by NSegments here dropped every segment but the last, because block_count already counts segments"
    },
    {
      "cmd": "#ACQ_jobs[0][0]",
      "conditions": [
        "@pv_version.split('.')[0]=='360'"
      ]
    }
  ],
  "scheme_id": [
    {
      "cmd": "'CART_2D'" ,
      "conditions": [
        ["#PULPROG",
          [
            "<FLASH.ppg>",
            "<FLASHAngio.ppg>",
            "<RAREVTR.ppg>",
            "<MGE.ppg>",
            "<RARE.ppg>",
            "<FLASHAngio.ppg>",
            "<FcFLASH.ppg>",
            "<DtiStandard.ppg>",
            "<FISP.ppg>",
            "<MSME.ppg>",
            "<FAIR_RARE.ppg>",
            "<RAREst.ppg>",
            "<FLOWMAP.ppg>",
            "<MDEFT.ppg>",
            "<igFLASH.ppg>",
            "<B1Map.ppg>",
            "<DESS.ppg>"
          ]
        ],
        "#ACQ_dim==2"
      ]
    },
    {
      "cmd": "'CART_3D'" ,
      "conditions": [
        ["#PULPROG[1:-1]",
          [
            "FLASH.ppg",
            "FLASHAngio.ppg",
            "RAREVTR.ppg",
            "MGE.ppg","RARE.ppg",
            "FLASHAngio.ppg",
            "FISP.ppg",
            "MDEFT.ppg"
          ]
        ],
        "#ACQ_dim==3"
      ]
    },
    {
      "cmd": "'FIELD_MAP'" ,
      "conditions": [
        ["#PULPROG[1:-1]",
          [
            "FieldMap.ppg"
          ]
        ]
      ]
    },
    {
      "cmd": "'RADIAL'" ,
      "conditions": [
        ["#PULPROG[1:-1]",
          [
            "UTE.ppg",
            "UTE3D.ppg"
          ]
        ]
      ]
    },
    {
      "cmd": "'EPI'" ,
      "conditions": [
        ["#PULPROG[1:-1]",
          [
            "EPI.ppg",
            "navigatorEPI_OM.ppg",
            "FAIR_EPI.ppg",
            "CASL_EPI.ppg",
            "T1_EPI.ppg",
            "T2_EPI.ppg",
            "T2S_EPI.ppg"
          ]
        ]
      ]
    },
    {
      "cmd": "'dEPI'" ,
      "conditions": [
        ["#PULPROG[1:-1]",
          [
            "DtiEpi.ppg",
            "EPSI.ppg"
          ]
        ]
      ]
    },
    {
      "cmd": "'SPECTROSCOPY'" ,
      "conditions": [
        ["#PULPROG[1:-1]",
          [
            "PRESS.ppg",
            "STEAM.ppg",
            "SINGLEPULSE.ppg",
            "NSPECT.ppg",
            "ISIS.ppg",
            "CPMG.ppg",
            "RfProfile.ppg",
            "fmap_fq.ppg",
            "ste_laser_dIR_WSTM.ppg"
          ]
        ]
      ]
    },
    {
      "cmd": "'CSI'" ,
      "conditions": [
        ["#PULPROG[1:-1]",
          [
            "CSI.ppg"
          ]
        ]
      ]
    },
    {
      "cmd": "'SPIRAL'" ,
      "conditions": [
        ["#PULPROG[1:-1]",
          [
            "SPIRAL.ppg",
            "DtiSpiral.ppg"
          ]
        ]
      ]
    },
    {
      "cmd": "'ZTE'" ,
      "conditions": [
        ["#PULPROG[1:-1]",
          [
            "ZTE.ppg"
          ]
        ]
      ]
    }
  ],
  "block_count": [
    {
      "cmd": "#NPro*#PVM_EncMatrix[2]*#NI*#NR",
      "conditions": [
        "@scheme_id=='RADIAL'",
        "#ACQ_dim==3",
        "np.atleast_1d(#PVM_EncMatrix).size>2",
        "#ACQ_size[1]==#NPro*#PVM_EncMatrix[2]"
      ]
    },
    {
      "cmd": "#NI*#NR*#PVM_EncMatrix[1]",
      "conditions": [
        "@scheme_id=='CART_2D'"
      ]
    },
    {
      "cmd": "#ACQ_size[1]*#ACQ_size[2]*#NR",
      "conditions": [
        "@scheme_id=='CART_3D'"
      ]
    },
    {
      "cmd": "#PVM_EncMatrix[1]*#PVM_EncMatrix[2]*#PVM_NEchoImages*#NR",
      "conditions": [
        "@scheme_id=='FIELD_MAP'"
      ]
    },
    {
      "cmd": "#NPro*#NI*#NR",
      "conditions": [
        "@scheme_id in ['RADIAL']"
      ]
    },
    {
      "cmd": "#NSegments*#NI*#NR",
      "conditions": [
        "@scheme_id=='EPI'"
      ]
    },
    {
      "cmd": "#NSegments*#ACQ_size[2]*#NI*#NR",
      "conditions": [
        "#GO_block_size!='Standard_KBlock_Format'",
        "#PULPROG[1:-1]=='EPSI.ppg'"
      ]
    },
    {
      "cmd": "#NSegments*#NI*#NR*(#ACQ_size[2] if len(#ACQ_size)>2 else 1)",
      "conditions": [
        "@scheme_id=='dEPI'"
      ]
    },
    {
      "cmd": "#NR*#NI",
      "conditions": [
        "@scheme_id=='SPECTROSCOPY'"
      ]
    },
    {
      "cmd": "#ACQ_size[1] * #ACQ_size[2]",
      "conditions": [
        "@scheme_id=='CSI'",
        "@pv_version.split('.')[0]!='360'"
      ]
    },
    {
      "cmd": "#ACQ_spatial_size_0 * #ACQ_spatial_size_1",
      "conditions": [
        "@scheme_id=='CSI'",
        "@pv_version.split('.')[0]=='360'"
      ]
    },
    {
      "cmd": "#PVM_SpiralNbOfInterleaves*#NI*#NR",
      "conditions": [
        "@scheme_id=='SPIRAL'",
        "@pv_version.split('.')[0]!='5'"
        ]
    },
    {
      "cmd": "#ACQ_size[1]*#NI*#NR",
      "conditions": [
        "@scheme_id=='SPIRAL'",
        "@pv_version.split('.')[0]=='5'"
      ]
    },
    {
      "cmd": "#NPro*#NI*#NR",
      "conditions": [
        "@scheme_id=='ZTE'"
      ]
    }
  ],
  "encoding_space": [
    {
      "cmd": [
        "#ACQ_size[0]//2",
        "#PVM_EncNReceivers",
        "#ACQ_phase_factor",
        "#NI",
        "#NPro // #ACQ_phase_factor",
        "#PVM_EncMatrix[2]",
        "#NR"
      ],
      "conditions": [
