        "#ACQ_size[2]"
      ],
      "conditions": [
        "@scheme_id=='CSI'",
        "@pv_version.split('.')[0]!='360'"
      ]
    },
    {
      "cmd": [
        "#ACQ_jobs[0][0]//2",
