        "#NI",
        "#PVM_EncMatrix[1] // #ACQ_phase_factor",
        "#NR"
      ],
      "conditions": [
        "@scheme_id=='CART_2D'"
      ]
    },
    {
      "cmd": [
        "#ACQ_size[0]//2",
        "#PVM_EncNReceivers",
