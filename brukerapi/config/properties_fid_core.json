      ]
    },
    {
      "cmd": [
        "#PVM_DigNp",
        "#PVM_EncNReceivers",
        "#NSegments",
        "#NI",
        "#NR"
      ],
      "conditions": [
        "@scheme_id=='EPI'"
      ]
    },
    {
      "cmd": [
        "#PVM_EncMatrix[0]",
        "#PVM_EncNReceivers",
        "#PVM_DigNp // #PVM_EncMatrix[0]",
        "#NSegments",
        "#ACQ_size[2]"
      ],
      "conditions": [
        "#GO_block_size!='Standard_KBlock_Format'",
        "#PULPROG[1:-1]=='EPSI.ppg'"
      ]
    },
    {
      "cmd": [
        "#PVM_EncMatrix[0] * #PVM_EncMatrix[1] // #NSegments",
        "#PVM_EncNReceivers",
        "#NSegments",
        "#NI",
        "#NR",
        "#ACQ_size[2] if len(#ACQ_size)>2 else 1"
      ],
      "conditions": [
        "@scheme_id=='dEPI'"
      ]
    },
    {
      "cmd": [
        "#ACQ_size.tuple[0] // 2",
        "#NI",
        "#NR"
      ],
      "conditions": [
        "@scheme_id=='SPECTROSCOPY'"
      ]
    },
    {
      "cmd": [
        "#ACQ_size[0]//2",
