        "#ACQ_spatial_size_1"
      ],
      "conditions": [
        "@scheme_id=='CSI'",
        "@pv_version.split('.')[0]=='360'"
      ]
    },
    {
      "cmd": [
        "#ACQ_size[0]//2",
        "#PVM_EncNReceivers",
        "#PVM_SpiralNbOfInterleaves",
        "#NI",
        "#NR"
      ],
      "conditions": [
        "@scheme_id=='SPIRAL'",
        "@pv_version.split('.')[0]!='5'"
      ]
    },
    {
      "cmd": [
        "#ACQ_size[0]//2",
        "#PVM_EncNReceivers",
        "#ACQ_size[1]",
        "#NI",
        "#NR"
      ],
      "conditions": [
        "@scheme_id=='SPIRAL'",
        "@pv_version.split('.')[0]=='5'"
      ]
    },
    {
      "cmd": [
        "#ACQ_size[0]//2",
        "#PVM_EncNReceivers",
        "#ACQ_phase_factor",
        "#NI",
        "#NPro // #ACQ_phase_factor",
        "#NR"
      ],
      "conditions": [
        "@scheme_id=='ZTE'"
      ]
    }
  ],
  "permute": [
