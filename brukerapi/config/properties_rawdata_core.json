{
  "pv_version": [
    {
      "cmd": "#ACQ_sw_version[1:-1].replace('PV-','').replace('PV ','').strip()",
      "conditions": [],
      "comment": "spec 7.1/13: version gates compare on this parsed version, so an unlisted point release is not silently unsupported"
    },
    {
      "cmd": "''",
      "conditions": []
    }
  ],
  "numpy_dtype": [
    {
        "cmd": "np.dtype('int32').newbyteorder('<')",
        "conditions": [
          "#GO_raw_data_format=='GO_32BIT_SGN_INT'",
          "#BYTORDA=='little'"
        ]
    },
    {
        "cmd": "np.dtype('int16').newbyteorder('<')",
        "conditions": [
          "#GO_raw_data_format=='GO_16BIT_SGN_INT'",
          "#BYTORDA=='little'"
        ]
    },
    {
        "cmd": "np.dtype('float32').newbyteorder('<')",
        "conditions": [
          "#GO_raw_data_format=='GO_32BIT_FLOAT'",
          "#BYTORDA=='little'"
        ]
    },
    {
        "cmd": "np.dtype('int32').newbyteorder('>')",
        "conditions": [
          "#GO_raw_data_format=='GO_32BIT_SGN_INT'",
          "#BYTORDA=='big'"
        ]
    },
    {
        "cmd": "np.dtype('int16').newbyteorder('>')",
        "conditions": [
          "#GO_raw_data_format=='GO_16BIT_SGN_INT'",
          "#BYTORDA=='big'"
        ]
    },
    {
        "cmd": "np.dtype('float32').newbyteorder('>')",
        "conditions": [
          "#GO_raw_data_format=='GO_32BIT_FLOAT'",
          "#BYTORDA=='big'"
        ]
    },
    {
        "cmd": "np.dtype('i4').newbyteorder('<')",
        "conditions": [
          "#ACQ_word_size=='_32_BIT'",
          "#BYTORDA=='little'",
          "@pv_version.split('.')[0]=='360'"
        ]
    },
    {
        "cmd": "np.dtype('i4').newbyteorder('>')",
        "conditions": [
          "#ACQ_word_size=='_32_BIT'",
          "#BYTORDA=='big'",
          "@pv_version.split('.')[0]=='360'"
        ]
    },
    {
        "cmd": "np.dtype('i2').newbyteorder('<')",
        "conditions": [
          "#ACQ_word_size=='_16_BIT'",
          "#BYTORDA=='little'",
          "@pv_version.split('.')[0]=='360'"
        ]
    },
    {
        "cmd": "np.dtype('i2').newbyteorder('>')",
        "conditions": [
          "#ACQ_word_size=='_16_BIT'",
          "#BYTORDA=='big'",
          "@pv_version.split('.')[0]=='360'"
        ]
    }
  ],
  "job_desc": [
    {
      "cmd": "[v for v in #ACQ_jobs.nested if v[-1] == '<{}>'.format(@subtype)][0]",
      "conditions": [
        "len(#ACQ_jobs.nested[0])==9"
      ]
    },
    {
      "cmd": "#ACQ_jobs.nested[int(@subtype[3:])]",
      "conditions": [
        "len(#ACQ_jobs.nested[0])==8"
      ]
    }
  ],
  "channels": [
    {
      "cmd": "#PVM_EncNReceivers",
      "conditions": [
      ]
    }
  ],
  "dim_type": [
    {
      "cmd": ["'sample'", "'channel'", "'scan'"],
      "conditions": []
    }
  ],
  "shape_storage": [
    {
      "cmd": "(@job_desc[0],) + (#PVM_EncNReceivers,) + (@job_desc[6] if len(@job_desc)==9 else @job_desc[3],)",
      "conditions": []
    }
  ]
}
