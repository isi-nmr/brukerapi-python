{
  "subj_id": [
      {
        "cmd": "#VisuSubjectId",
        "conditions": [
        ]
      },
      {
        "cmd": "''",
        "conditions": [
        ]
      }
  ],
  "study_id": [
      {
        "cmd": "str(#VisuStudyNumber)",
        "conditions": [
        ]
      },
      {
        "cmd": "''",
        "conditions": [
        ]
      }
  ],
  "exp_id": [
      {
        "cmd": "@path.parents[2].name",
        "conditions": [
        ]
      },
      {
        "cmd": "''",
        "conditions": [
        ]
      }
  ],
  "proc_id": [
      {
        "cmd": "@path.parents[0].name",
        "conditions": [
        ]
      },
      {
        "cmd": "''",
        "conditions": [
        ]
      }
  ],
  "id": [
      {
        "cmd": "'2DSEQ_{}_{}_{}_{}'.format(@exp_id, @proc_id, @subj_id, @study_id)",
        "conditions": [
        ]
      }
  ],
  "extent": [
    {
      "cmd": "np.array([#PVM_VoxArrSize[0,0] * #VisuAcqSize[1], #PVM_VoxArrSize[0,1] * #VisuAcqSize[2], np.atleast_1d(#VisuCoreFrameThickness)[0]])",
      "conditions": [
        "@pv_version.split('.')[0]=='5'",
        "#VisuCoreDimDesc.list[0]=='spectroscopic'",
        "#VisuCoreDimDesc.list[1]=='spatial'",
        "#VisuCoreDimDesc.list[2]=='spatial'"]
    },
    {
      "cmd": "np.array([#PVM_VoxArrSize[0,0], #PVM_VoxArrSize[0,1], #PVM_VoxArrSize[0,2]])",
      "conditions": [
        "@pv_version.split('.')[0]!='5'",
        "#VisuCoreDimDesc.list[0]=='spectroscopic'",
        "#VisuCoreDimDesc.list[1]=='spatial'",
        "#VisuCoreDimDesc.list[2]=='spatial'"]
    },
    {
      "cmd": "np.array([#VisuCoreExtent[0], #VisuCoreExtent[1], np.shape(#VisuCorePosition)[0] * np.linalg.norm(#VisuCorePosition[1,:] - #VisuCorePosition[0,:])])",
      "conditions": [
        "@is_single_slice==False",
        "#VisuCoreDim==2"
      ],
      "comment": "spec 7.2/12: VisuCorePosition is a 3-vector in patient coordinates and the slice normal is the third row of VisuCoreOrientation, so the step is the length of the whole difference -- the z component alone is zero for every coronal, sagittal or oblique stack. n slices span n steps, matching resolution[2] and the in-plane extent = size * resolution"
    },
    {
      "cmd": "np.array([#VisuCoreExtent[0], #VisuCoreExtent[1], np.atleast_1d(#VisuCoreFrameThickness)[0]])",
      "conditions": [
        "@is_single_slice==True",
        "#VisuCoreDim==2"
      ]
    },
    {
      "cmd": "np.array([#VisuCoreExtent[0], #VisuCoreExtent[1], #VisuCoreExtent[2]])",
      "conditions": [
        "#VisuCoreDimDesc.list[0]=='spatial'",
        "#VisuCoreDimDesc.list[1]=='spatial'",
        "#VisuCoreDimDesc.list[2]=='spatial'"]
    }
  ],
  "resolution": [
    {
      "cmd": "np.array([#PVM_VoxArrSize[0,0], #PVM_VoxArrSize[0,1], np.atleast_1d(#VisuCoreFrameThickness)[0]])",
      "conditions": [
        "@pv_version.split('.')[0]=='5'",
        "#VisuCoreDimDesc.list[0]=='spectroscopic'",
        "#VisuCoreDimDesc.list[1]=='spatial'",
        "#VisuCoreDimDesc.list[2]=='spatial'"]
    },
    {
      "cmd": "np.array([#PVM_VoxArrSize[0,0] / #VisuCoreSize[1], #PVM_VoxArrSize[0,1] / #VisuCoreSize[2], #PVM_VoxArrSize[0,2]])",
      "conditions": [
        "@pv_version.split('.')[0]!='5'",
        "#VisuCoreDimDesc.list[0]=='spectroscopic'",
        "#VisuCoreDimDesc.list[1]=='spatial'",
        "#VisuCoreDimDesc.list[2]=='spatial'"]
    },
    {
      "cmd": "np.array([#VisuCoreExtent[0] / #VisuCoreSize[0], #VisuCoreExtent[1] / #VisuCoreSize[1], np.linalg.norm(#VisuCorePosition[1,:] - #VisuCorePosition[0,:])])",
      "conditions": [
        "@is_single_slice==False",
        "#VisuCoreDim==2"],
      "comment": "spec 7.10: the distance between two measured slice centres. VisuCoreSlicePacksSliceDist is already centre-to-centre, so it must not be added to VisuCoreFrameThickness"
    },
    {
      "cmd": "np.array([#VisuCoreExtent[0] / #VisuCoreSize[0], #VisuCoreExtent[1] / #VisuCoreSize[1], #VisuCoreSlicePacksSliceDist.list[0]])",
      "conditions": [
        "#VisuCoreDim==2"]
    },
    {
      "cmd": "np.array([#VisuCoreExtent[0] / #VisuCoreSize[0], #VisuCoreExtent[1] / #VisuCoreSize[1], np.atleast_1d(#VisuCoreFrameThickness)[0]])",
      "conditions": [
        "#VisuCoreDim==2"]
    },
    {
      "cmd": "np.array([#VisuCoreExtent[0] / #VisuCoreSize[0], #VisuCoreExtent[1] / #VisuCoreSize[1], #VisuCoreExtent[2] / #VisuCoreSize[2]])",
      "conditions": [
        "#VisuCoreDimDesc.list[0]=='spatial'",
        "#VisuCoreDimDesc.list[1]=='spatial'",
        "#VisuCoreDimDesc.list[2]=='spatial'"]
    }
  ],
  "TE": [
      {
        "cmd": "#VisuAcqEchoTime",
        "conditions": [
        ]
      }
  ],
  "TR": [
      {
        "cmd": "#VisuAcqRepetitionTime",
        "conditions": [
        ]
      }
  ],
  "imaging_frequency": [
    {
        "cmd": "#VisuAcqImagingFrequency",
        "conditions": [
        ]
    }
  ],
  "date": [
      {
        "cmd": "datetime.datetime.strptime(#VisuStudyDate, '%X %d %b %Y')",
        "conditions": [
          "'T' not in #VisuStudyDate"
        ]
      },
      {
        "cmd": "datetime.datetime.strptime(#VisuStudyDate, '%Y-%m-%dT%X,%f%z')",
        "conditions": [
          "'T' in #VisuStudyDate"
        ]
      }
  ],
  "dwell_s": [
    {
      "cmd": "1./ (#VisuAcqPixelBandwidth * #VisuCoreSize.list[0])  / 2.",
      "conditions": []
    },
    {
      "cmd": "None",
      "conditions": [],
      "comment": "default value"
    }
  ]
}
