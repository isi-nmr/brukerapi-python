{
  "pv_version": [
      {
        "cmd": "#VisuCreatorVersion[1:-1].split(';')[0]",
        "conditions": [],
        "comment": "spec 7.1: VisuCreator/VisuCreatorVersion are semicolon-separated lists; the first creator is the one that wrote the dataset"
      }
  ],
  "numpy_dtype": [
    {
        "cmd": "np.dtype('int32').newbyteorder('<')",
        "conditions": [
          ["#VisuCoreWordType",["_32BIT_SGN_INT"]],
          ["#VisuCoreByteOrder",["littleEndian"]]
        ]
    },
    {
        "cmd": "np.dtype('int16').newbyteorder('<')",
        "conditions": [
          ["#VisuCoreWordType",["_16BIT_SGN_INT"]],
          ["#VisuCoreByteOrder",["littleEndian"]]
        ]
    },
    {
        "cmd": "np.dtype('float32').newbyteorder('<')",
        "conditions": [
          ["#VisuCoreWordType",["_32BIT_FLOAT"]],
          ["#VisuCoreByteOrder",["littleEndian"]]
        ]
    },
    {
        "cmd": "np.dtype('uint8').newbyteorder('<')",
        "conditions": [
          ["#VisuCoreWordType",["_8BIT_UNSGN_INT"]],
          ["#VisuCoreByteOrder",["littleEndian"]]
        ]
    },
        {
        "cmd": "np.dtype('int32').newbyteorder('>')",
        "conditions": [
          ["#VisuCoreWordType",["_32BIT_SGN_INT"]],
          ["#VisuCoreByteOrder",["bigEndian"]]
        ]
    },
    {
        "cmd": "np.dtype('int16').newbyteorder('>')",
        "conditions": [
          ["#VisuCoreWordType",["_16BIT_SGN_INT"]],
          ["#VisuCoreByteOrder",["bigEndian"]]
        ]
    },
    {
        "cmd": "np.dtype('float32').newbyteorder('>')",
        "conditions": [
          ["#VisuCoreWordType",["_32BIT_FLOAT"]],
          ["#VisuCoreByteOrder",["bigEndian"]]
        ]
    },
    {
        "cmd": "np.dtype('uint8').newbyteorder('>')",
        "conditions": [
          ["#VisuCoreWordType",["_8BIT_UNSGN_INT"]],
          ["#VisuCoreByteOrder",["bigEndian"]]
        ]
    },
    {
        "cmd": "np.dtype({'_32BIT_SGN_INT':'int32','_16BIT_SGN_INT':'int16','_32BIT_FLOAT':'float32','_8BIT_UNSGN_INT':'uint8'}[#RECO_wordtype]).newbyteorder('<' if #RECO_byte_order=='littleEndian' else '>')",
        "conditions": ["#RECO_wordtype in ['_32BIT_SGN_INT','_16BIT_SGN_INT','_32BIT_FLOAT','_8BIT_UNSGN_INT']", "#RECO_byte_order in ['littleEndian','bigEndian']"]
    },
    {
        "cmd": "np.dtype(DATTYPE_WORD_TYPES[str(#DATTYPE)]).newbyteorder('>' if int(np.atleast_1d(#PR_STA)[15]) else '<')",
        "conditions": ["str(#DATTYPE) in DATTYPE_WORD_TYPES", "len(np.atleast_1d(#PR_STA))>15"]
    },
    {
        "cmd": "np.dtype(DATTYPE_WORD_TYPES[str(#DATTYPE)]).newbyteorder('<')",
        "conditions": ["str(#DATTYPE) in DATTYPE_WORD_TYPES"]
    }
  ],
  "shape_frames": [
      {
        "cmd": "#VisuCoreFrameCount.tuple",
        "conditions": []
      }
  ],
  "is_single_slice": [
      {
        "cmd": "True",
        "conditions": [
          "#VisuCorePosition.shape[0]==1",
          "#VisuCoreDim<3"
        ]
      },
      {
        "cmd": "False",
        "conditions": ["#VisuCorePosition.shape[0]>1"]
      },
      {
        "cmd": "False",
        "conditions": ["#VisuCoreDim==3"]
      },
      {
        "cmd": "False",
        "conditions": []
      }
],
  "shape_fg": [
      {
        "cmd": "(1,) + tuple(np.array(#VisuFGOrderDesc.nested)[:,0].astype('int'))",
        "conditions": ["@is_single_slice"]
      },
      {
        "cmd": "tuple(np.array(#VisuFGOrderDesc.nested)[:,0].astype('int'))",
        "conditions": []
      },
      {
        "cmd": "(1,)",
        "conditions": []
      }
  ],
  "shape_block": [
      {
        "cmd": "#VisuCoreSize.tuple",
        "conditions": []
      },
      {
        "cmd": "(int(#IM_SIX), int(#IM_SIY))",
        "conditions": [],
        "comment": "spec 8: IM_SIX/IM_SIY are the in-plane matrix written after transposition; IM_SIZ is the number of frames, which shape_frames already counts"
      },
      {
        "cmd": "transposed_size(#RECO_size.tuple, #RECO_transposition)",
        "conditions": [],
        "comment": "spec 6.9: RECO_size still refers to the non-transposed ordering, so the stored frame shape is RECO_size with the recorded exchange applied"
      },
      {
        "cmd": "#RECO_size.tuple",
        "conditions": []
      }
  ],
  "encoded_dim": [
      {
        "cmd": "len(#VisuCoreSize.tuple)",
        "conditions": []
      },
      {
        "cmd": "len(@shape_block)",
        "conditions": []
      }
  ],
  "shape_storage":[
    {
      "cmd": "@shape_block+@shape_frames",
      "conditions": []
    }
  ],
  "shape_final":[
    {
      "cmd": "@shape_block+@shape_fg",
      "conditions": []
    }
  ],
  "num_slice_packages": [
      {
        "cmd": "len(@slice_packages_index())",
        "conditions": []
      }
  ],
  "slope": [
    {
      "cmd": "#VisuCoreDataSlope.array",
      "conditions": []
    },
    {
      "cmd": "1.0 / #RECO_map_slope.array",
      "conditions": [],
      "comment": "spec 3.4: real = pixel / RECO_map_slope + RECO_map_offset, so VisuCoreDataSlope = 1 / RECO_map_slope. Multiplying instead of dividing makes values slope^2 too small"
    }
  ],
  "offset": [
    {
      "cmd": "#VisuCoreDataOffs.array",
      "conditions": []
    },
    {
      "cmd": "#RECO_map_offset.array",
      "conditions": []
    }
  ],
  "dim_type": [
    {
      "cmd": "#VisuCoreDimDesc.list + ['frame',] + #VisuFGOrderDesc.sub_list(1)",
      "conditions": ["@is_single_slice==True"]
    },
    {
      "cmd": "#VisuCoreDimDesc.list + ['frame',]",
      "conditions": ["@is_single_slice==True"]
    },
    {
      "cmd": "#VisuCoreDimDesc.list + #VisuFGOrderDesc.sub_list(1)",
      "conditions": ["@is_single_slice==False"]
    },
    {
      "cmd": "#VisuCoreDimDesc.list + ['frame']",
      "conditions": ["@is_single_slice==False"]
    }
  ]
}
